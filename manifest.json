{
  "manifest_version": 3,
  "name": "North: Focus & Distraction Blocker",
  "short_name": "North",
  "version": "1.0.0",
  "description": "Free for life. Blocks Shorts, Reels, TikTok, distracting sites and keywords, with schedules, time limits and an unlock you have to mean.",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "webNavigation",
    "idle",
    "notifications"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js",
    "scripts": ["src/background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "north@northfocus.app",
      "strict_min_version": "121.0"
    }
  },
  "action": {
    "default_popup": "pages/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "North"
  },
  "options_page": "pages/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"],
      "js": ["content/youtube.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://www.instagram.com/*", "*://instagram.com/*"],
      "js": ["content/instagram.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://www.linkedin.com/*"],
      "js": ["content/linkedin.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://www.twitch.tv/*", "*://twitch.tv/*"],
      "js": ["content/twitch.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/global.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["pages/blocked.html", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
