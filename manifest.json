{
  "manifest_version": 3,
  "name": "North: Focus & Distraction Blocker",
  "short_name": "North",
  "version": "1.3.0",
  "description": "Free forever. Blocks short-form video, distracting sites and keywords, with schedules, daily limits, and an unlock you have to mean.",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "webNavigation",
    "idle",
    "notifications"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js",
    "scripts": ["src/background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "north@northfocus.app",
      "strict_min_version": "121.0"
    }
  },
  "action": {
    "default_popup": "pages/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "North"
  },
  "options_page": "pages/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"],
      "js": ["content/youtube.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://www.instagram.com/*", "*://instagram.com/*"],
      "js": ["content/instagram.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://www.linkedin.com/*"],
      "js": ["content/linkedin.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://www.twitch.tv/*", "*://twitch.tv/*"],
      "js": ["content/twitch.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.nytimes.com/*", "*://*.washingtonpost.com/*", "*://*.theguardian.com/*",
        "*://*.bbc.com/*", "*://*.bbc.co.uk/*", "*://*.cnn.com/*", "*://*.foxnews.com/*",
        "*://*.reuters.com/*", "*://*.apnews.com/*", "*://*.bloomberg.com/*",
        "*://*.forbes.com/*", "*://*.businessinsider.com/*", "*://*.nbcnews.com/*",
        "*://*.abcnews.go.com/*", "*://*.cbsnews.com/*", "*://*.usatoday.com/*",
        "*://*.theverge.com/*", "*://*.techcrunch.com/*", "*://*.arstechnica.com/*",
        "*://*.wired.com/*", "*://*.vox.com/*", "*://*.politico.com/*", "*://*.npr.org/*",
        "*://*.aljazeera.com/*", "*://*.time.com/*", "*://*.newsweek.com/*",
        "*://*.thehill.com/*", "*://*.dailymail.co.uk/*", "*://*.telegraph.co.uk/*",
        "*://*.independent.co.uk/*", "*://*.huffpost.com/*", "*://*.latimes.com/*",
        "*://*.nypost.com/*", "*://*.cnbc.com/*"
      ],
      "js": ["content/news.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/global.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["pages/blocked.html", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
