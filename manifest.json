{
  "manifest_version": 3,
  "name": "North — Focus Companion & Distraction Blocker",
  "short_name": "North",
  "version": "1.0.0",
  "description": "Find your true north. Blocks distracting sites, short-form feeds and keywords on a schedule, with time limits and a buddy that keeps you honest.",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "webNavigation",
    "idle",
    "notifications"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "pages/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "North — Focus Companion"
  },
  "options_page": "pages/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"],
      "js": ["content/youtube.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://www.instagram.com/*", "*://instagram.com/*"],
      "js": ["content/instagram.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/global.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["pages/blocked.html", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
